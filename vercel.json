{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": {
    "//": "Previews only. Disabling deployments for main means Vercel never builds a production deployment, so no stable *.vercel.app URL exists that could be mistaken for the field app. GitHub Pages stays the field deployment.",
    "deploymentEnabled": {
      "main": false
    }
  },
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/(index.html)?",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "//": "Emitted without a content hash because the service worker precaches them by name.",
      "source": "/(main.js|styles.css)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "//": "Vite content-hashes everything under assets/, so it is safe to cache hard.",
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
